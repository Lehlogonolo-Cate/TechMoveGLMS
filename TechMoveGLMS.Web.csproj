<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseAppHost>false</UseAppHost>
		<DefaultItemExcludes>
			$(DefaultItemExcludes);TechMoveGLMS.Tests/**;TechMoveGLMS.Api/**
		</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="TechMoveGLMS.Tests/**/*.cs" />
		<Content Remove="TechMoveGLMS.Tests/**" />
		<None Remove="TechMoveGLMS.Tests/**" />
		<EmbeddedResource Remove="TechMoveGLMS.Tests/**" />

		<Compile Remove="TechMoveGLMS.Api/**/*.cs" />
		<Content Remove="TechMoveGLMS.Api/**" />
		<None Remove="TechMoveGLMS.Api/**" />
		<EmbeddedResource Remove="TechMoveGLMS.Api/**" />
	</ItemGroup>

</Project>