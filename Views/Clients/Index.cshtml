@model IEnumerable<TechMoveGLMS.Web.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Clients</h1>
        <p class="text-muted">
            Manage TechMove Logistics clients and their contact information.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add New Client
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No clients have been added yet.
        Select <strong>Add New Client</strong> to create the first client.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Client Name</th>
                            <th>Contact Details</th>
                            <th>Region</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var client in Model)
                        {
                            <tr>
                                <td>@client.Name</td>
                                <td>@client.ContactDetails</td>
                                <td>@client.Region</td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@client.ClientId"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@client.ClientId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@client.ClientId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
