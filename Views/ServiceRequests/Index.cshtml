@model IEnumerable<TechMoveGLMS.Web.Models.ServiceRequest>
@using TechMoveGLMS.Web.Models

@{
    ViewData["Title"] = "Service Requests";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold">Service Request Management</h1>
            <p class="text-muted">
                Manage logistics requests and converted service costs.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-lg">
            Add New Request
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            Search and Filter Service Requests
        </div>

        <div class="card-body">
            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">Search</label>

                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Description, client or service level" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Contract</label>

                    <select name="contractId"
                            asp-items="ViewBag.Contracts"
                            class="form-select">
                        <option value="">All contracts</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>

                    <select name="status"
                            asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()"
                            class="form-select">
                        <option value="">All statuses</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No service requests have been recorded yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Client</th>
                                <th>Description</th>
                                <th>Cost (USD)</th>
                                <th>Exchange Rate</th>
                                <th>Cost (ZAR)</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in Model)
                            {
                                var statusClass = request.Status switch
                                {
                                    ServiceRequestStatus.Pending
                                        => "bg-warning text-dark",

                                    ServiceRequestStatus.Approved
                                        => "bg-info text-dark",

                                    ServiceRequestStatus.InProgress
                                        => "bg-primary",

                                    ServiceRequestStatus.Completed
                                        => "bg-success",

                                    ServiceRequestStatus.Cancelled
                                        => "bg-danger",

                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td>
                                        <strong>
                                            @request.Contract?.Client?.Name
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @request.Contract?.ServiceLevel
                                        </small>
                                    </td>

                                    <td>@request.Description</td>

                                    <td>
                                        $@request.CostUsd.ToString("N2")
                                    </td>

                                    <td>
                                        @request.ExchangeRate.ToString("N4")
                                    </td>

                                    <td>
                                        R @request.Cost.ToString("N2")
                                    </td>

                                    <td>
                                        <span class="badge @statusClass">
                                            @request.Status
                                        </span>
                                    </td>

                                    <td>
                                        @request.CreatedAt.ToString(
                                            "dd MMM yyyy HH:mm")
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@request.ServiceRequestId"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@request.ServiceRequestId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@request.ServiceRequestId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>