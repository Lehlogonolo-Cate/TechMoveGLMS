@model TechMoveGLMS.Web.Models.ServiceRequest
@using TechMoveGLMS.Web.Models

@{
    ViewData["Title"] = "Edit Service Request";
}

<div class="container py-4">
    <div class="card shadow mx-auto"
         style="max-width: 900px;">

        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Edit Service Request</h2>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-info">
                Saving changes will retrieve the latest USD/ZAR exchange
                rate and recalculate the cost in Rand.
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden"
                       asp-for="ServiceRequestId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="ContractId"
                           class="form-label">
                    </label>

                    <select asp-for="ContractId"
                            asp-items="ViewBag.Contracts"
                            class="form-select">
                        <option value="">
                            Select an active contract
                        </option>
                    </select>

                    <span asp-validation-for="ContractId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="CostUsd"
                           class="form-label">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">$</span>

                        <input asp-for="CostUsd"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01" />
                    </div>

                    <span asp-validation-for="CostUsd"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status"
                           class="form-label">
                    </label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
