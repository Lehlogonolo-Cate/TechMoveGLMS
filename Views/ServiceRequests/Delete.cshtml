@model TechMoveGLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<div class="container py-4">
    <div class="card border-danger shadow mx-auto"
         style="max-width: 900px;">

        <div class="card-header bg-danger text-white">
            <h2 class="mb-0">Delete Service Request</h2>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning">
                Are you sure you want to delete this service request?
                This action cannot be undone.
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Request Number
                </div>

                <div class="col-md-8">
                    SR-@Model.ServiceRequestId.ToString("D4")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Client</div>

                <div class="col-md-8">
                    @Model.Contract?.Client?.Name
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Service Level
                </div>

                <div class="col-md-8">
                    @Model.Contract?.ServiceLevel
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Description
                </div>

                <div class="col-md-8">
                    @Model.Description
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Cost in USD
                </div>

                <div class="col-md-8">
                    $@Model.CostUsd.ToString("N2")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Cost in ZAR
                </div>

                <div class="col-md-8">
                    R @Model.Cost.ToString("N2")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Status</div>

                <div class="col-md-8">
                    @Model.Status
                </div>
            </div>
        </div>

        <div class="card-footer">
            <form asp-action="Delete" method="post">
                <input type="hidden"
                       asp-for="ServiceRequestId" />

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
