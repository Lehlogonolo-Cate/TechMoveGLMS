@model TechMoveGLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Add Service Request";
}

<div class="container py-4">
    <div class="card shadow mx-auto"
         style="max-width: 900px;">

        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Add New Service Request</h2>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-info">
                Service requests can only be created for active contracts.
                The USD cost will automatically be converted to South
                African Rand using a live exchange rate.
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="ContractId"
                           class="form-label">
                    </label>

                    <select asp-for="ContractId"
                            asp-items="ViewBag.Contracts"
                            class="form-select">
                        <option value="">
                            Select an active contract
                        </option>
                    </select>

                    <span asp-validation-for="ContractId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Describe the logistics service required">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="CostUsd"
                           class="form-label">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">$</span>

                        <input asp-for="CostUsd"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               placeholder="0.00" />
                    </div>

                    <span asp-validation-for="CostUsd"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        The ZAR value and exchange rate will be calculated
                        automatically when the request is saved.
                    </small>
                </div>

                <div class="mb-4">
                    <label class="form-label">Initial Status</label>

                    <input type="text"
                           value="Pending"
                           class="form-control"
                           readonly />

                    <small class="text-muted">
                        Every new service request begins with Pending status.
                    </small>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Service Request
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}