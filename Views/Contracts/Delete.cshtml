@model TechMoveGLMS.Web.Models.Contract

@{
    ViewData["Title"] = "Delete Contract";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-danger">

            <div class="card-header bg-danger text-white">
                <h2 class="h4 mb-0">Delete Contract</h2>
            </div>

            <div class="card-body">
                <div class="alert alert-warning">
                    Are you sure you want to delete this contract?
                    This action cannot be undone.
                </div>

                <dl class="row">

                    <dt class="col-sm-4">Client</dt>
                    <dd class="col-sm-8">@Model.Client?.Name</dd>

                    <dt class="col-sm-4">Service Level</dt>
                    <dd class="col-sm-8">@Model.ServiceLevel</dd>

                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">
                        @Model.StartDate.ToString("dd MMMM yyyy")
                    </dd>

                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">
                        @Model.EndDate.ToString("dd MMMM yyyy")
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>

                    <dt class="col-sm-4">Service Requests</dt>
                    <dd class="col-sm-8">
                        @Model.ServiceRequests.Count
                    </dd>

                </dl>

                @if (Model.ServiceRequests.Any())
                {
                    <div class="alert alert-danger">
                        This contract cannot be deleted because it has
                        associated service requests.
                    </div>
                }
            </div>

            <div class="card-footer">
                <form asp-action="Delete" method="post">

                    <input type="hidden"
                           asp-for="ContractId" />

                    @if (!Model.ServiceRequests.Any())
                    {
                        <button type="submit"
                                class="btn btn-danger">
                            Confirm Delete
                        </button>
                    }

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </form>
            </div>
        </div>
    </div>
</div>