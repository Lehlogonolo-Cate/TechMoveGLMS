@model TechMoveGLMS.Web.Models.Contract

@using TechMoveGLMS.Web.Models

@{
    ViewData["Title"] = "Add Contract";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h2 class="h4 mb-0">Add New Contract</h2>
            </div>

            <div class="card-body">
                <form asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClientId"
                               class="form-label">
                            Client
                        </label>

                        <select asp-for="ClientId"
                                asp-items="ViewBag.ClientId"
                                class="form-select">
                            <option value="">
                                Select a client
                            </option>
                        </select>

                        <span asp-validation-for="ClientId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ServiceLevel"
                               class="form-label">
                            Service Level Agreement
                        </label>

                        <input asp-for="ServiceLevel"
                               class="form-control"
                               placeholder="For example: Premium 24/7 Support" />

                        <span asp-validation-for="ServiceLevel"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate"
                                   class="form-label">
                                Start Date
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate"
                                   class="form-label">
                                End Date
                            </label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="EndDate"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status"
                               class="form-label">
                            Contract Status
                        </label>

                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<ContractStatus>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="agreementFile"
                               class="form-label">
                            Legal Agreement PDF
                        </label>

                        <input type="file"
                               id="agreementFile"
                               name="agreementFile"
                               accept=".pdf,application/pdf"
                               class="form-control" />

                        <div class="form-text">
                            Optional. Only PDF files up to 5 MB are allowed.
                        </div>

                        <span class="text-danger">
                            @Html.ValidationMessage("agreementFile")
                        </span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Save Contract
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}